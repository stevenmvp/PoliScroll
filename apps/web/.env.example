# Variables de entorno para la aplicación Web (Vite + AWS Amplify)

# Región de AWS donde está alojado tu User Pool (por ejemplo: us-east-1, us-east-2, sa-east-1)
VITE_AWS_REGION=us-east-1

# ID del User Pool de Amazon Cognito (por ejemplo: us-east-1_xxxxxxxxx)
VITE_COGNITO_USER_POOL_ID=

# ID del Cliente de la Aplicación (App Client ID - asegúrate de que no tenga Client Secret para SPA web)
VITE_COGNITO_CLIENT_ID=
