# Fase 0 no requiere variables de entorno para compilar.
# Completar estas variables únicamente al iniciar las fases correspondientes.

NODE_ENV=development
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
DATABASE_URL=
REDIS_URL=
API_BASE_URL=# AWS Amplify / Frontend
NEXT_PUBLIC_APP_NAME=PoliScroll
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_example
NEXT_PUBLIC_COGNITO_CLIENT_ID=exampleclientid
NEXT_PUBLIC_COGNITO_DOMAIN=example.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000
NEXT_PUBLIC_COGNITO_RESPONSE_TYPE=code
NEXT_PUBLIC_ENABLE_PWA=true

# Backend / API
API_PORT=4000
JWT_SECRET=replace-with-strong-secret
DATABASE_URL=postgresql://user:password@host:5432/poliscroll
REDIS_URL=redis://localhost:6379

# AI
AI_API_KEY=replace-with-ai-key
AI_MODEL_NAME=gpt-4o-mini
AI_TIMEOUT_MS=15000

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=poliscroll-assets

# Cognito backend config
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid
COGNITO_CLIENT_SECRET=exampleclientsecret
COGNITO_REGION=us-east-1
